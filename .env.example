# ==========================================
# Firebase Client SDK (NEXT_PUBLIC_* = baked at build time)
# These MUST be real values when you run `docker compose build` for production.
# They get embedded into the JS bundle during the build step.
# ==========================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_real_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_real_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_real_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_real_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# ==========================================
# Firebase Admin SDK (runtime only, JSON string)
# This is read at runtime by the server, not baked into the bundle.
# ==========================================
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your_project_id","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
